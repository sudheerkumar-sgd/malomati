# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Local Flutter --dart-define-from-file for FCM (never commit secrets)
fcm_dart_defines.json

# Android-only FCM injection for Gradle / Android Studio (never commit secrets)
android/fcm.local.properties

# iOS: optional FCM dart-define append (never commit secrets)
ios/Flutter/fcm-dart-defines.xcconfig

# Avoid committing generated Javascript files:
*.dart.js
*.info.json      # Produced by the --dump-info flag.
*.js             # When generated by dart2js. Don't specify *.js if your
                 # project includes source files written in JavaScript.
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies
android/.idea
.DS_Store
android/app/production/release/
/android/app/.cxx
.DS_Store
ios/Podfile.lock
ios/Runner.xcodeproj/xcshareddata/xcschemes/production.xcscheme
*.hprof
